{
  "name": "hotelcost",
  "version": "0.1.0",
  "private": true,
  "description": "HotelCost — hotel cost intelligence & cost-control platform",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:all": "vitest run",
    "test:coverage": "vitest run --project unit --coverage",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:reset": "prisma migrate reset --force",
    "db:seed": "tsx prisma/seed.ts",
    "vba:gen": "tsx scripts/gen-vba.ts",
    "prebuild": "tsx scripts/gen-vba.ts",
    "excel:sample": "tsx scripts/excel-smoke.ts",
    "excel:validate": "python3 scripts/lo-validate.py",
    "pack:sample": "tsx scripts/pack-sample.ts",
    "ops:backup": "bash scripts/ops/backup.sh",
    "ops:restore": "bash scripts/ops/restore.sh",
    "ops:verify-restore": "tsx scripts/ops/verify-restore.ts",
    "stress:seed": "tsx scripts/stress.ts --seed",
    "stress:measure": "tsx scripts/stress.ts --measure",
    "test:tenant-isolation": "vitest run --project integration tests/integration/tenancy.test.ts tests/integration/hardening.test.ts",
    "test:permissions": "vitest run --project integration tests/integration/permissions.test.ts tests/integration/security.test.ts",
    "seed:demo": "tsx scripts/demo.ts seed --profile=dev",
    "seed:staging": "tsx scripts/demo.ts seed --profile=staging",
    "seed:qa": "tsx scripts/demo.ts seed --profile=tiny",
    "demo:reset": "tsx scripts/demo.ts reset",
    "demo:verify": "tsx scripts/demo.ts verify",
    "demo:crawl": "tsx scripts/qa/crawl-demo.ts",
    "test:demo-ui": "playwright test -c playwright.demo.config.ts",
    "test:reconciliation": "vitest run --project integration tests/integration/demo-dataset.test.ts tests/integration/demo-engine.test.ts",
    "test:excel": "vitest run --project unit tests/unit/excel-bulk.test.ts tests/unit/vba-project.test.ts && vitest run --project integration tests/integration/excel-export.test.ts",
    "vercel-build": "node scripts/check-build-env.mjs && prisma generate && tsx scripts/gen-vba.ts && DATABASE_URL=\"${DATABASE_URL_UNPOOLED:-$DATABASE_URL}\" prisma migrate deploy && next build",
    "setup:first-company": "tsx scripts/first-company.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "cfb": "^1.2.2",
    "clsx": "^2.1.1",
    "decimal.js": "^10.6.0",
    "exceljs": "^4.4.0",
    "jszip": "^3.10.2",
    "lucide-react": "^1.51.0",
    "next": "^15.5.27",
    "pdfkit": "^0.17.2",
    "react": "~19.1.9",
    "react-dom": "~19.1.9",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.56.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.20.5",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^3.2.7",
    "autoprefixer": "^10.6.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.13.0",
    "pg": "^8.23.1",
    "postcss": "^8.5.28",
    "prisma": "^6.19.3",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.15",
    "typescript": "5.9",
    "typescript-eslint": "^8.71.0",
    "vitest": "^3.2.7"
  }
}
