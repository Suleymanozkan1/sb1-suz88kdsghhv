# HotelCost Micros/Opera botu — yapılandırma örneği.
# Bu dosyayı ".env" adıyla kopyalayın ve değerleri doldurun. ".env" dosyasını asla paylaşmayın / git'e koymayın.
# Ortam değişkenleri (environment) .env dosyasındaki değerlerin önüne geçer.

# --- Oracle Micros (POS + satınalma) web arayüzü ---
MICROS_URL=https://micros.otel.local/
MICROS_USERNAME=
MICROS_PASSWORD=
# Ekran seçicileri (selectors) dosyası. Varsayılan: selectors/micros.json
# MICROS_SELECTORS=selectors/micros.json

# --- Opera PMS (isteğe bağlı; boş bırakılırsa doluluk/occupancy okunmaz) ---
OPERA_URL=
OPERA_USERNAME=
OPERA_PASSWORD=
# OPERA_SELECTORS=selectors/opera.json

# --- HotelCost ---
HOTELCOST_URL=https://hotelcost.example.com
# HotelCost > Entegrasyonlar ekranında otel için üretilen anahtar
HOTELCOST_API_KEY=

# --- Zamanlama ---
TIMEZONE=Europe/Istanbul
# Gece kapanışı (night audit) bitiş saati: iş günü bu saatte biter
# varsayılan; HotelCost Yönetim > "İş günü bitişi" ayarı bağlanınca bunun yerine geçer
NIGHT_AUDIT_CUTOFF=03:30
# Gece çalışmasının saati (yerel saat, kapanıştan sonra olmalı)
RUN_AT=04:15
# "Şimdi çalıştır" isteklerini kontrol etme aralığı (dakika)
POLL_MINUTES=2
# Makine RUN_AT saatinde kapalıysa açıldığında o günün çalışmasını yap (true/false)
CATCH_UP=true

# --- Tarayıcı ---
# false yaparsanız tarayıcı penceresi görünür (seçici ayarlarken faydalı)
HEADLESS=true
# Tek bir ekran işlemi için bekleme süresi (ms)
TIMEOUT_MS=30000
# Bilgisayarda kurulu Chrome/Edge kullanmak için: chrome | msedge (boş = Playwright Chromium)
# BROWSER_CHANNEL=

# --- Satınalma faturaları kaynağı ---
# web  = Micros satınalma web ekranından oku
# file = INVOICE_IMPORT_DIR klasörüne bırakılan CSV/XLSX dışa aktarımlarını oku
INVOICE_SOURCE=web
INVOICE_IMPORT_DIR=./invoice-import

# --- Diğer ---
# Bir istekte gönderilecek en fazla çek sayısı
CHECKS_CHUNK_SIZE=500
# Hata ekran görüntüleri ve çalışma kayıtları
RUNS_DIR=./runs
STATE_DIR=./state
# debug | info | warn | error
LOG_LEVEL=info
# Micros/Opera sunucusu kendinden imzalı (self-signed) sertifika kullanıyorsa true (yalnızca otel iç ağı için)
IGNORE_HTTPS_ERRORS=false
