DATABASE_URL="postgresql://hotelcost:hotelcost@localhost:5432/hotelcost?schema=public"
TEST_DATABASE_URL="postgresql://hotelcost:hotelcost@localhost:5432/hotelcost_test?schema=public"
# Signs password reset links (src/server/services/account.ts); links are also bound to the user's password hash
SESSION_SECRET="change-me-to-a-long-random-string-at-least-32-chars"
# Optional: public URL written into the Excel CONTROL sheet (defaults to the request host). Password reset links use
# only this address (on Vercel also the production domain), never the request's Host header: without it and SMTP_URL,
# "Forgot your password?" is not offered.
# PUBLIC_BASE_URL="https://hotelcost.example.com"
# Optional: login attempts per 15-minute window (shared by all instances via PostgreSQL)
# RATE_LIMIT_LOGIN_PER_IP=30
# RATE_LIMIT_LOGIN_PER_EMAIL=8          (per e-mail and client address)
# RATE_LIMIT_LOGIN_PER_EMAIL_TOTAL=50   (per e-mail from all addresses)
# Optional: reverse proxies in front of the app that append to X-Forwarded-For (on Vercel x-real-ip is used).
# An internet-facing self-hosted install must run behind a proxy that OVERWRITES the header (nginx, Caddy, IIS ARR):
# Next.js gives route handlers no socket address, so without one the per-IP login limit trusts the client.
# TRUSTED_PROXY_HOPS=0
# Optional: first-run /setup code. Required when the database password is a default (e.g. docker-compose's)
# SETUP_TOKEN="a-long-random-value"
# Optional: keep finished background Excel files this many hours (default 24)
# EXPORT_JOB_TTL_HOURS=24

# Automatic e-mail orders (Premium plan) and password reset e-mails. Without SMTP_URL nothing is sent and the screen says so.
SMTP_URL=
MAIL_FROM="HotelCost <siparis@otel.example>"
# Nightly job (Vercel cron → /api/cron/nightly): Vercel sends this as a Bearer token.
CRON_SECRET=
# Packages and billing (src/server/plans.ts). Billing applies only when a platform operator organization exists (SaaS);
# a self-hosted installation keeps every feature. Each new tenant starts a 30-day trial with every feature.
# Self-hosted / licensed: fix the plan of every tenant (BASIC | STANDARD | PREMIUM).
PLAN_OVERRIDE=
# QA / demos only: every feature open for every tenant. OFF unless set (it used to default to on).
# TRIAL_ALL_FEATURES=1
# Set to off to disable subscription enforcement (read-only after expiry, package gates) on a SaaS installation.
# BILLING_ENFORCEMENT=on

# SaaS: visitors without a session see the public product page (/welcome) instead of the sign-in form.
# PUBLIC_LANDING=1
# Address of the "Book a demo" button on the product page.
# PUBLIC_CONTACT_EMAIL=sales@example.com

# Logging (JSON lines on stdout/stderr): debug | info | warn | error
# LOG_LEVEL=info
# Optional: errors are also POSTed here (Slack / Teams / Discord incoming webhook or any JSON endpoint), at most once
# per distinct message per minute.
# ERROR_WEBHOOK_URL=
